#!/usr/bin/env python3
"""Native-messaging bridge. Runs as the browser user and only reads effective state."""

from __future__ import annotations

import json
import logging
from logging.handlers import RotatingFileHandler
import os
import struct
import sys
import time
from pathlib import Path

STATE = Path("/var/lib/siteblock/effective-state.json")
CLIENTS = Path("/run/siteblock/browser-clients.json")
LOG_FILE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "siteblock" / "bridge.log"


def setup_bridge_logger() -> logging.Logger:
    logger = logging.getLogger("siteblock-bridge")
    logger.setLevel(logging.INFO)
    if not logger.handlers:
        formatter = logging.Formatter(
            "%(asctime)s [%(levelname)s] [pid=%(process)d] %(message)s",
            datefmt="%Y-%m-%d %H:%M:%S",
        )
        try:
            LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
            file_handler = RotatingFileHandler(
                LOG_FILE, maxBytes=2 * 1024 * 1024, backupCount=2, encoding="utf-8"
            )
            file_handler.setFormatter(formatter)
            logger.addHandler(file_handler)
        except OSError:
            pass

        stderr_handler = logging.StreamHandler(sys.stderr)
        stderr_handler.setFormatter(formatter)
        logger.addHandler(stderr_handler)
    return logger


LOGGER = setup_bridge_logger()


def read_message() -> object | None:
    header = sys.stdin.buffer.read(4)
    if not header:
        return None
    length = struct.unpack("@I", header)[0]
    payload = sys.stdin.buffer.read(length)
    return json.loads(payload.decode("utf-8"))


def send(message: object) -> None:
    LOGGER.debug("Enviando estado para extensão do navegador: %s", message)
    payload = json.dumps(message, ensure_ascii=False).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("@I", len(payload)) + payload)
    sys.stdout.buffer.flush()


def state() -> dict:
    try:
        value = json.loads(STATE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as err:
        LOGGER.debug("Não foi possível ler effective-state.json (%s), usando fallback", err)
        value = {"active": False, "domains": [], "revision": 0}
    return {"active": bool(value.get("active")), "domains": value.get("domains", []), "revision": value.get("revision", 0)}


def record_client(kind: str) -> None:
    CLIENTS.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    clients = {}
    try:
        clients = json.loads(CLIENTS.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        pass
    timestamp = int(time.time())
    clients[kind] = timestamp
    clients["updatedAt"] = timestamp
    temporary = CLIENTS.with_suffix(".tmp")
    temporary.write_text(json.dumps(clients), encoding="utf-8")
    temporary.replace(CLIENTS)


def main() -> int:
    kind = sys.argv[1] if len(sys.argv) > 1 else "chromium"
    LOGGER.info("Bridge iniciado para navegador: '%s' (PID: %d)", kind, os.getpid())
    record_client(kind)
    previous = None
    while True:
        incoming = read_message()
        if incoming is None:
            LOGGER.info("Canal stdin do bridge fechado pelo navegador. Encerrando bridge.")
            return 0
        LOGGER.debug("Mensagem recebida da extensão: %s", incoming)
        next_state = state()
        if next_state != previous:
            LOGGER.info("Novo estado detectado (revision: %s, active: %s), enviando para extensão", next_state.get("revision"), next_state.get("active"))
            send(next_state)
            previous = next_state
        heartbeat = time.monotonic()
        while True:
            time.sleep(0.5)
            if time.monotonic() - heartbeat >= 5:
                record_client(kind)
                heartbeat = time.monotonic()
            next_state = state()
            if next_state != previous:
                LOGGER.info("Novo estado detectado no loop (revision: %s, active: %s), enviando para extensão", next_state.get("revision"), next_state.get("active"))
                send(next_state)
                previous = next_state


if __name__ == "__main__":
    raise SystemExit(main())
