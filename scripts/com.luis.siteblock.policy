<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "https://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="com.luis.siteblock.helper">
    <description>Alterar regras do SiteBlock</description>
    <message>É necessária autenticação para alterar o bloqueio de sites.</message>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/siteblock/siteblock-admin</annotate>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  </action>
</policyconfig>
