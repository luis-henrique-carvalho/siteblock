#!/usr/bin/env python3
"""Root helper for SiteBlock. It applies local blocking without network access."""

from __future__ import annotations

import datetime as dt
import hashlib
import json
import logging
from logging.handlers import RotatingFileHandler
import os
import re
import shutil
import sys
import tempfile
from pathlib import Path

LOG_FILE = Path("/var/log/siteblock-admin.log")


def setup_logger() -> logging.Logger:
    logger = logging.getLogger("siteblock-admin")
    logger.setLevel(logging.INFO)
    if not logger.handlers:
        formatter = logging.Formatter(
            "%(asctime)s [%(levelname)s] [pid=%(process)d] %(message)s",
            datefmt="%Y-%m-%d %H:%M:%S",
        )
        try:
            LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
            file_handler = RotatingFileHandler(
                LOG_FILE, maxBytes=5 * 1024 * 1024, backupCount=3, encoding="utf-8"
            )
            file_handler.setFormatter(formatter)
            logger.addHandler(file_handler)
        except OSError:
            # Em fallback ou modo sem permissão de escrita em /var/log
            pass

        stderr_handler = logging.StreamHandler(sys.stderr)
        stderr_handler.setFormatter(formatter)
        logger.addHandler(stderr_handler)
    return logger


LOGGER = setup_logger()

BASE = Path("/etc/siteblock")
CONFIG = BASE / "config.json"
HOSTS = Path("/etc/hosts")
RUNTIME = Path("/var/lib/siteblock")
EFFECTIVE_STATE = RUNTIME / "effective-state.json"
FIREFOX_OWNERSHIP = BASE / "firefox-policy.sha256"
FIREFOX_POLICY = Path("/etc/firefox/policies/policies.json")
BEGIN = "# BEGIN SITEBLOCK MANAGED"
END = "# END SITEBLOCK MANAGED"
DOMAIN_RE = re.compile(r"(?!-)(?:[a-z0-9-]+\.)+[a-z]{2,}$", re.IGNORECASE)
TIME_RE = re.compile(r"(?:[01]\d|2[0-3]):[0-5]\d$")
CHROMIUM_POLICIES = {
    "Chrome": Path("/etc/opt/chrome/policies/managed/com.luis.siteblock.json"),
    "Brave": Path("/etc/brave/policies/managed/com.luis.siteblock.json"),
}
CHROMIUM_EXTENSION_ID = "ejhdjlpfeejbkjmmdnhcgnpjlcllldko"
CHROMIUM_EXTERNAL_REGISTRATIONS = {
    "Chrome": [Path(f"/opt/google/chrome/extensions/{CHROMIUM_EXTENSION_ID}.json")],
    "Brave": [
        Path(f"/opt/brave.com/brave/extensions/{CHROMIUM_EXTENSION_ID}.json"),
        Path(f"/usr/share/brave/extensions/{CHROMIUM_EXTENSION_ID}.json"),
    ],
}
RELATED_HOSTS = {
    "youtube.com": [
        "m.youtube.com",
        "music.youtube.com",
        "youtu.be",
        "www.youtu.be",
        "youtube-nocookie.com",
        "www.youtube-nocookie.com",
    ],
}
DEFAULT_CONFIG = {"enabled": False, "domains": [], "schedules": []}


def read_json(path: Path, fallback: object) -> object:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return fallback


def atomic_write(path: Path, content: str, mode: int = 0o644) -> None:
    path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, delete=False) as file:
        file.write(content)
        temporary = Path(file.name)
    temporary.chmod(mode)
    temporary.replace(path)


def write_json(path: Path, value: object, mode: int = 0o644) -> None:
    atomic_write(path, json.dumps(value, ensure_ascii=False, indent=2) + "\n", mode)


def read_config() -> dict:
    if not CONFIG.exists():
        return DEFAULT_CONFIG.copy()
    try:
        return normalize(read_json(CONFIG, DEFAULT_CONFIG.copy()))
    except ValueError:
        return DEFAULT_CONFIG.copy()


def normalize(value: object) -> dict:
    if not isinstance(value, dict):
        raise ValueError("A configuração deve ser um objeto JSON.")
    domains = value.get("domains", [])
    schedules = value.get("schedules", [])
    if not isinstance(domains, list) or not isinstance(schedules, list):
        raise ValueError("Domínios e horários precisam ser listas.")
    cleaned_domains = []
    for domain in domains:
        if not isinstance(domain, str):
            raise ValueError("Domínio inválido.")
        domain = domain.lower().removeprefix("www.").strip()
        if not DOMAIN_RE.fullmatch(domain):
            raise ValueError(f"Domínio inválido: {domain}")
        if domain not in cleaned_domains:
            cleaned_domains.append(domain)
    cleaned_schedules = []
    for schedule in schedules:
        if not isinstance(schedule, dict):
            raise ValueError("Período inválido.")
        ident, days, start, end = schedule.get("id"), schedule.get("days"), schedule.get("start"), schedule.get("end")
        if not isinstance(ident, str) or not isinstance(days, list) or not isinstance(start, str) or not isinstance(end, str):
            raise ValueError("Período incompleto.")
        if not TIME_RE.fullmatch(start) or not TIME_RE.fullmatch(end) or start == end:
            raise ValueError("Horário inválido.")
        days = sorted(set(days))
        if not days or any(not isinstance(day, int) or day < 0 or day > 6 for day in days):
            raise ValueError("Escolha pelo menos um dia válido.")
        cleaned_schedules.append({"id": ident[:80], "days": days, "start": start, "end": end})
    return {"enabled": bool(value.get("enabled", False)), "domains": cleaned_domains, "schedules": cleaned_schedules}


def write_config(config: dict) -> None:
    write_json(CONFIG, config)


def minute(value: str) -> int:
    hours, minutes = value.split(":")
    return int(hours) * 60 + int(minutes)


def applies_now(schedule: dict, now: dt.datetime) -> bool:
    current_day, current_minute = now.weekday(), now.hour * 60 + now.minute
    start, end = minute(schedule["start"]), minute(schedule["end"])
    if start < end:
        return current_day in schedule["days"] and start <= current_minute < end
    previous_day = (current_day - 1) % 7
    return (current_day in schedule["days"] and current_minute >= start) or (previous_day in schedule["days"] and current_minute < end)


def should_block(config: dict) -> bool:
    if not config["enabled"] or not config["domains"]:
        return False
    return not config["schedules"] or any(applies_now(item, dt.datetime.now()) for item in config["schedules"])


def domain_hosts(domain: str) -> list[str]:
    return [domain, f"www.{domain}", *RELATED_HOSTS.get(domain, [])]


def blocked_hosts(config: dict) -> list[str]:
    return list(dict.fromkeys(host for domain in config["domains"] for host in domain_hosts(domain)))


def blocked_url_filters(config: dict, enabled: bool) -> list[str]:
    if not enabled:
        return []
    filters = []
    for host in blocked_hosts(config):
        filters.extend([f"*://{host}/*", f"*://*.{host}/*"])
    return list(dict.fromkeys(filters))


def active() -> bool:
    try:
        return BEGIN in HOSTS.read_text(encoding="utf-8")
    except OSError:
        return False


def write_hosts(config: dict, enabled: bool) -> None:
    original = HOSTS.read_text(encoding="utf-8")
    kept, in_block = [], False
    for line in original.splitlines():
        if line == BEGIN:
            in_block = True
            continue
        if line == END:
            in_block = False
            continue
        if not in_block:
            kept.append(line)
    if enabled:
        kept.extend(["", BEGIN])
        for domain in config["domains"]:
            aliases = domain_hosts(domain)
            kept.append(f"0.0.0.0 {' '.join(aliases)}")
            kept.append(f"::1 {' '.join(aliases)}")
        kept.append(END)
        LOGGER.info("Aplicando bloqueio no /etc/hosts para %d domínios: %s", len(config["domains"]), config["domains"])
    else:
        LOGGER.info("Removendo entradas de bloqueio do /etc/hosts")
    mode = HOSTS.stat().st_mode & 0o777
    atomic_write(HOSTS, "\n".join(kept).rstrip() + "\n", mode)


def browser_present(commands: tuple[str, ...]) -> bool:
    return any(shutil.which(command) for command in commands)


def write_chromium_policies(filters: list[str]) -> dict[str, bool]:
    results = {}
    for browser, path in CHROMIUM_POLICIES.items():
        write_json(path, {"URLBlocklist": filters})
        results[browser] = True
        LOGGER.debug("Política Chromium atualizada para %s (%s) com %d filtros", browser, path, len(filters))
    return results


def file_digest(path: Path) -> str | None:
    try:
        return hashlib.sha256(path.read_bytes()).hexdigest()
    except OSError:
        return None


def write_firefox_policy(filters: list[str]) -> bool:
    """Own only the policy file we created; never overwrite another administrator's file."""
    previous_digest = FIREFOX_OWNERSHIP.read_text(encoding="utf-8").strip() if FIREFOX_OWNERSHIP.exists() else None
    current_digest = file_digest(FIREFOX_POLICY)
    if FIREFOX_POLICY.exists() and previous_digest != current_digest:
        LOGGER.warning("Política do Firefox existente não pertence ao SiteBlock (digest mismatch). Ignorando escrita.")
        return False
    write_json(FIREFOX_POLICY, {"policies": {"WebsiteFilter": {"Block": filters}}})
    atomic_write(FIREFOX_OWNERSHIP, file_digest(FIREFOX_POLICY) or "")
    LOGGER.debug("Política do Firefox atualizada (%s) com %d filtros", FIREFOX_POLICY, len(filters))
    return True


def read_browser_clients() -> dict[str, int]:
    clients = read_json(Path("/run/siteblock/browser-clients.json"), {})
    if not isinstance(clients, dict):
        return {}
    now = int(dt.datetime.now(dt.timezone.utc).timestamp())
    return {
        str(name): int(value)
        for name, value in clients.items()
        if name != "updatedAt" and isinstance(value, int) and now - value < 15
    }


def browser_integrations(chromium: dict[str, bool], firefox_policy: bool) -> list[dict]:
    clients = read_browser_clients()
    browsers = [
        ("Chrome", browser_present(("google-chrome", "google-chrome-stable")), chromium.get("Chrome", False), "chromium"),
        ("Brave", browser_present(("brave-browser", "brave")), chromium.get("Brave", False), "chromium"),
        ("Firefox", browser_present(("firefox",)), firefox_policy, "firefox"),
    ]
    return [
        {
            "name": name,
            "detected": detected,
            "policyReady": policy_ready,
            "extensionRegistered": any(path.exists() for path in CHROMIUM_EXTERNAL_REGISTRATIONS.get(name, [])),
            "extensionConnected": kind in clients,
            "mode": "Regras dinâmicas" if kind in clients else "Política do navegador",
        }
        for name, detected, policy_ready, kind in browsers
    ]


def effective_payload(config: dict, enabled: bool) -> dict:
    previous = read_json(EFFECTIVE_STATE, {})
    desired = {"active": enabled, "domains": blocked_hosts(config) if enabled else []}
    old_desired = {key: previous.get(key) for key in desired} if isinstance(previous, dict) else {}
    revision = int(previous.get("revision", 0)) if isinstance(previous, dict) else 0
    if desired != old_desired:
        revision += 1
    return {**desired, "revision": revision, "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat()}


def write_effective_state(config: dict, enabled: bool) -> dict:
    payload = effective_payload(config, enabled)
    write_json(EFFECTIVE_STATE, payload)
    return payload


def state(config: dict, chromium: dict[str, bool] | None = None, firefox_policy: bool | None = None) -> dict:
    chromium = chromium or {name: path.exists() for name, path in CHROMIUM_POLICIES.items()}
    if firefox_policy is None:
        firefox_policy = FIREFOX_POLICY.exists() and FIREFOX_OWNERSHIP.exists()
    effective = read_json(EFFECTIVE_STATE, {})
    revision = effective.get("revision", 0) if isinstance(effective, dict) else 0
    return {
        "active": active(),
        "enabled": config["enabled"],
        "domains": config["domains"],
        "schedules": config["schedules"],
        "helperInstalled": True,
        "revision": revision,
        "browserIntegrations": browser_integrations(chromium, firefox_policy),
    }


def apply(config: dict) -> dict:
    enabled = should_block(config)
    LOGGER.info("Aplicando estado de bloqueio: enabled=%s, active=%s, domains=%s", config.get("enabled"), enabled, config.get("domains"))
    write_hosts(config, enabled)
    filters = blocked_url_filters(config, enabled)
    chromium = write_chromium_policies(filters)
    firefox_policy = write_firefox_policy(filters)
    eff = write_effective_state(config, enabled)
    LOGGER.info("Estado efetivo atualizado: revision=%s, active=%s", eff.get("revision"), eff.get("active"))
    return state(config, chromium, firefox_policy)


def require_root() -> None:
    if os.geteuid() != 0:
        LOGGER.error("Tentativa de executar ação privilegiada sem UID 0 (euid=%d)", os.geteuid())
        raise PermissionError("Essa ação precisa de autorização administrativa.")


def session() -> int:
    """Serve validated requests on stdin while the desktop app remains open."""
    require_root()
    LOGGER.info("Sessão administrativa iniciada (PID: %d, UID: %d)", os.getpid(), os.geteuid())
    for line in sys.stdin:
        try:
            request = json.loads(line)
            action = request.get("action")
            LOGGER.debug("Sessão recebeu ação: %s", action)
            if action == "status":
                response = state(read_config())
            elif action == "set-config":
                config = normalize(request.get("config"))
                LOGGER.info("Salvando nova configuração via sessão administrativa")
                write_config(config)
                response = apply(config)
            else:
                LOGGER.warning("Ação desconhecida recebida na sessão: %s", action)
                raise ValueError("Ação inválida.")
        except (OSError, PermissionError, ValueError, json.JSONDecodeError) as error:
            LOGGER.error("Erro ao processar mensagem na sessão: %s", error)
            response = {"error": str(error)}
        print(json.dumps(response, ensure_ascii=False), flush=True)
    LOGGER.info("Sessão administrativa finalizada (stdin fechado)")
    return 0


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    LOGGER.debug("siteblock-admin invocado com comando: '%s'", command)
    if command == "status":
        print(json.dumps(state(read_config()), ensure_ascii=False))
        return 0
    if command == "capabilities":
        print(json.dumps({"session": True, "browserIntegration": True, "integrationVersion": 2}))
        return 0
    if command == "session":
        return session()
    if command not in {"set-config", "reconcile"}:
        print("Uso: siteblock-admin status|set-config|reconcile|session|capabilities", file=sys.stderr)
        return 2
    require_root()
    config = normalize(json.load(sys.stdin)) if command == "set-config" else read_config()
    if command == "set-config":
        LOGGER.info("Comando 'set-config' executado via CLI")
        write_config(config)
    elif command == "reconcile":
        LOGGER.info("Comando 'reconcile' executado (agendador/systemd)")
    print(json.dumps(apply(config), ensure_ascii=False))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, PermissionError, ValueError, json.JSONDecodeError) as error:
        LOGGER.error("Erro fatal: %s", error)
        print(f"Erro: {error}", file=sys.stderr)
        raise SystemExit(1)
